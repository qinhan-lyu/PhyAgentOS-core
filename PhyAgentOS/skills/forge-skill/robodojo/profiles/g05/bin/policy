#!/usr/bin/env sh
set -eu
: "${ROBODOJO_ENV:?set ROBODOJO_ENV to RoboDojo env root}"
: "${XPOLICYLAB_ROOT:?set XPOLICYLAB_ROOT to XPolicyLab checkout}"
: "${G05_CKPT_PATH:?set G05_CKPT_PATH}"
: "${G05_PROCESSOR_PATH:?set G05_PROCESSOR_PATH}"
export PYTHONPATH="${XPOLICYLAB_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONNOUSERSITE="${PYTHONNOUSERSITE:-1}"
if [ -n "${CUDA_HOME:-}" ]; then
  export PATH="${CUDA_HOME}/bin${PATH:+:${PATH}}"
fi
if [ -n "${ROBODOJO_CACHE_ROOT:-}" ]; then
  export HF_HOME="${HF_HOME:-$ROBODOJO_CACHE_ROOT/hf}"
  export MODELSCOPE_CACHE="${MODELSCOPE_CACHE:-$ROBODOJO_CACHE_ROOT/modelscope}"
fi
exec "${ROBODOJO_ENV}/bin/python" -u "${PAOS_SKILL_ROOT}/nodes/benchmarks/robodojo/policy_node.py" "$@"
